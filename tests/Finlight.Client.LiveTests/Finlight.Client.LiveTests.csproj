<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Live tests against the finlight DEV environment only. Not part of the solution, so the normal
    `dotnet test` never runs them. Each run needs the owner's okay. Run with:
      FINLIGHT_API_KEY=... FINLIGHT_BASE_URL=https://api.dev.finlight.me FINLIGHT_WSS_URL=wss://wss.dev.finlight.me \
        dotnet test tests/Finlight.Client.LiveTests
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Finlight.LiveTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Finlight.Client\Finlight.Client.csproj" />
  </ItemGroup>

</Project>
