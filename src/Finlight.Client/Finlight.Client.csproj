<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Finlight</RootNamespace>
    <AssemblyName>Finlight.Client</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>false</IsTrimmable>

    <!-- The one version source: CI overrides it from the release tag (-p:Version=...). -->
    <Version>2.0.0</Version>

    <PackageId>Finlight.Client</PackageId>
    <Authors>finlight</Authors>
    <Description>Breaking release: 2.x speaks finlight API v3 only (1.x spoke v2). Official .NET client for the finlight.me financial news API: REST v3 search and lookups, real-time WebSocket streams (payloadVersion 3) and webhook verification.</Description>
    <PackageTags>finlight;news;finance;sentiment;websocket;streaming;webhooks</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://docs.finlight.me</PackageProjectUrl>
    <PackageReleaseNotes>2.0.0: client for finlight API v3 only. See CHANGELOG.md and the migration section of the README.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/callbk/finlight-client-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Primitives" Version="8.0.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Finlight.Client.Tests" />
  </ItemGroup>

</Project>
